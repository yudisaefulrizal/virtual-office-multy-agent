# MySQL 8+. Docker (npm run db:up) memakai port 3307; MySQL lokal biasanya 3306.
DATABASE_URL=mysql://vo:vo@localhost:3307/vo
TEST_DATABASE_URL=mysql://vo:vo@localhost:3307/vo_test
PORT=8070
WORKSPACES_DIR=./workspaces

# Runtime Claude CLI (login langganan, bukan API key)
CLAUDE_CLI_BIN=claude
# Opsional: config dir terpisah agar agent tidak memakai login/setting pribadi.
# Kosong = pakai login Claude yang sudah ada.
CLAUDE_CONFIG_DIR=
CLAUDE_CLI_CONCURRENCY=3
CLAUDE_CLI_MAX_RUNS_PER_WINDOW=30
CLAUDE_CLI_WINDOW_HOURS=5
# subscription = biaya dicatat sebagai estimasi; api = biaya nyata
CLAUDE_CLI_BILLING=subscription

# Model default agent baru. sonnet lebih hemat kuota Pro daripada opus.
VO_DEFAULT_MODEL=sonnet
# Paksa semua agent memakai runtime tertentu (mis. fake) saat development tanpa kuota.
VO_FORCE_RUNTIME=

# Kunci enkripsi API key provider (64 hex). Kosong = dibuat otomatis di .vo-secret.
VO_SECRET_KEY=

# Alamat publik aplikasi untuk login Instagram (Redirect URI di Meta App = APP_ORIGIN/auth/instagram/callback).
# Meta umumnya mewajibkan HTTPS; pakai domain/tunnel publik bila mengujinya sungguhan.
APP_ORIGIN=http://localhost:8070
